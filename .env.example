# Copy via pnpm setup:env; generated .env files are ignored.
DATABASE_URL=postgresql://openhr:openhr_dev_only@localhost:5432/openhr?schema=public
# setup:env replaces this placeholder with 32 random bytes encoded as hex.
DATA_ENCRYPTION_KEY=GENERATE_WITH_SETUP_ENV
APP_ORIGIN=http://localhost:3000
PORT=3001
API_INTERNAL_URL=http://localhost:3001
NODE_ENV=development
# Production requires HTTPS, NODE_ENV=production, and independently managed secrets.
