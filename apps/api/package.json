{
  "name": "@openhr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "provision": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@openhr/compliance": "workspace:*",
    "@openhr/shared": "workspace:*",
    "@prisma/client": "~6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3"
  }
}
