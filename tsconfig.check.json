{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "packages/shared/src/**/*.ts",
    "tests/**/*.ts",
    "*config.ts"
  ]
}
